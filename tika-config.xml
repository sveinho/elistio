<?xml version="1.0" encoding="UTF-8"?>
<properties>
    <detectors>
        <!-- Tving Tika til å kjøre Magika først -->
        <detector class="org.apache.tika.detect.magika.MagikaDetector">
            <params>
                <!-- Fortell Tika hvor magika-kommandoen ligger på systemet -->
                <param name="magikaPath" type="string">/usr/local/bin/magika</param>
                <!-- Bruk Magikas prediksjon som den reelle mime-typen for ruting til parsere -->
                <param name="useMime" type="boolean">true</param>
            </params>
        </detector>
        
        <!-- Standard fallbacks dersom Magika ikke skulle klare å identifisere filen -->
        <detector class="org.apache.tika.detect.DefaultDetector"/>
    </detectors>
</properties>